ว ไม่สามารถแก้ไขร่างได้',DELIVERY_REFERENCE_INVALID:'กรุณาใช้ลิงก์ HTTPS ที่ไม่มีชื่อผู้ใช้หรือรหัสผ่าน',REQUEST_STORE_NOT_CONFIGURED:'ระบบรับคำขอยังไม่พร้อม กรุณาติดต่อ Admin',REQUEST_STORE_UNAVAILABLE:'บันทึกข้อมูลไม่สำเร็จ กรุณาลองใหม่',ADMIN_AUTH_REQUIRED:'กรุณาตรวจรหัสเข้าถึง Admin',REQUEST_CHANGED_RELOAD:'ข้อมูลเปลี่ยนแปลงแล้ว กรุณารอโหลดสถานะล่าสุดและลองใหม่',ADMIN_MUST_TAKE_OVER:'กรุณากด Admin รับช่วง ก่อนตอบลูกค้า',DELIVERY_CONTENT_REQUIRED:'กรุณาใส่ผลงานจริงที่ต้องการส่งมอบ',STATUS_TRANSITION_DENIED:'กรุณาเปลี่ยนสถานะตามลำดับงาน',SESSION_EXPIRED:'เซสชันหมดอายุ กรุณาติดต่อ Admin พร้อมเลขคำขอ',REQUEST_NOT_FOUND:'ไม่พบคำขอที่คุณมีสิทธิ์เข้าถึง',MESSAGE_CONFLICT:'ข้อความนี้ถูกส่งแล้ว กรุณาโหลดประวัติล่าสุด'};\nfunction notice(text){$('notice').textContent='System — '+text}\nfunction reportError(error){notice(errors[error?.message]||errors.REQUEST_FAILED)}\nasync function api(path='',data){const epoch=sessionEpoch;const response=await fetch(base+path,{method:data===undefined?'GET':'POST',headers:{...(data===undefined?{}:{'content-type':'application/json'}),...(ADMIN?{authorization:'Bearer '+credential}:{})},...(data===undefined?{}:{body:JSON.stringify(data)})});const result=await response.json();if(ADMIN&&epoch!==sessionEpoch)throw Error('SESSION_CHANGED');if(!response.ok)throw Error(result.code||'REQUEST_FAILED');return result}\nfunction show(result,replaceFields=false){const r=result.request;if(selected!==r.request_id)return;if(current?.request.request_id===r.request_id&&(current.request.version>r.version||(current.request.version===r.version&&current.messages.length>result.messages.length)))return;current=result;$('request-id').textContent='เลขคำขอ: '+selected;$('status').textContent=r.status_label;$('responder').textContent='ผู้ดูแลการสนทนา: '+r.responder_label;\n if(replaceFields||!dirty)fields.forEach(k=>{$(k).value=r.brief[k]||''});fields.forEach(k=>{$(k).disabled=saving||ADMIN||r.status!=='DRAFT'});if(!ADMIN){$('save').disabled=r.status!=='DRAFT';$('confirm').disabled=r.status!=='DRAFT'}\n const target=$('messages'),nearBottom=target.scrollHeight-target.scrollTop-target.clientHeight<90;target.replaceChildren();result.messages.forEach(m=>{const node=document.createElement('div');node.className='message';const label=document.createElement('strong');label.textContent=m.sender_label;const text=document.createElement('div');text.textContent=m.text;const time=document.createElement('time');time.dateTime=m.timestamp;time.textContent=new Date(m.timestamp).toLocaleString('th-TH');node.append(label,text,time);target.append(node)});if(nearBottom||replaceFields)target.scrollTop=target.scrollHeight;\n $('history').replaceChildren();result.events.filter(e=>e.kind!=='MESSAGE'&&e.kind!=='DRAFT_UPDATED').forEach(e=>{const line=document.createElement('p');const who={ADMIN:'Admin',AI:'AI - GO',SYSTEM:'System',CUSTOMER:'คุณ'}[e.actor_type]||'System';const values={DRAFT:'บันทึกร่าง',SUBMITTED:'ศูนย์รับงาน',REVIEWING:'กำลังตรวจสอบ',IN_PROGRESS:'กำลังดำเนินงาน',DELIVERED:'ส่งมอบงาน',FOLLOW_UP:'ติดตามผล'};line.textContent=who+' · '+(values[e.to_value]||(e.kind==='HANDOFF'?(e.to_value.startsWith('ADMIN:')?'Admin รับช่วง':'AI - GO กลับมาดูแล'):e.to_value))+' · '+new Date(e.timestamp).toLocaleString('th-TH');$('history').append(line)});\n $('delivery').replaceChildren();if(r.delivery_text){const content=document.createElement('pre');content.style.whiteSpace='pre-wrap';content.style.overflowWrap='anywhere';content.textContent=r.delivery_text;const digest=document.createElement('small');digest.textContent='SHA-256: '+r.delivery_sha256;$('delivery').append(content,digest)}if(r.delivery_url){const link=document.createElement('a');link.textContent='เปิดผลงานที่ส่งมอบ';link.href=r.delivery_url;link.target='_blank';link.rel='noopener noreferrer';$('delivery').append(link)}\n}\n\n// Compositions are page-memory only: never share text, retries or delivery drafts across requests.\nfunction composition(requestId=selected){if(!compositions.has(requestId))compositions.set(requestId,{text:'',pending:null,sending:false,deliveryText:'',deliveryUrl:'',nextStatus:'REVIEWING'});return compositions.get(requestId)}\nfunction captureComposition(){if(!selected)return;const state=composition();state.text=$('text').value;if(ADMIN){state.deliveryText=$('delivery-text').value;state.deliveryUrl=$('delivery-url').value;state.nextStatus=$('next-status').value}}\nfunction restoreComposition(){const state=composition();$('text').value=state.text;$('send').disabled=state.sending;if(ADMIN){$('delivery-text').value=state.deliveryText;$('delivery-url').value=state.deliveryUrl;$('next-status').value=state.nextStatus}}\nfunction choose(result){captureComposition();selected=result.request.request_id;show(result,true);restoreComposition();const picker=$('requests');if(!Array.from(picker.children).some(option=>option.value===selected)){const option=document.createElement('option');option.value=selected;option.textContent=selected+' — '+result.request.status_label;picker.append(option)}picker.value=selected;if(!ADMIN)try{sessionStorage.setItem(selectionKey,selected)}catch{}}\nfunction clearAdminView(){sessionEpoch++;credential='';selected='';current=null;dirty=false;nextCursor=null;compositions.clear();fields.forEach(k=>{$(k).value='';$(k).disabled=true});['text','delivery-text','delivery-url'].forEach(k=>{$(k).value=''});['requests','messages','history','delivery'].forEach(k=>$(k).replaceChildren());['request-id','status','responder'].forEach(k=>{$(k).textContent=''});$('more').hidden=true;$('send').disabled=true}\nglobalThis.addEventListener?.('beforeunload',event=>{captureComposition();if(dirty||Array.from(compositions.values()).some(s=>s.text||s.pending||s.sending||(ADMIN&&(s.deliveryText||s.deliveryUrl)))){event.preventDefault();event.returnValue=''}});\n\nasync function list(append=false){const data=await api(append&&nextCursor?'?cursor='+nextCursor:'');nextCursor=data.next_cursor;$('more').hidden=!nextCursor;const picker=$('requests');if(!append)picker.replaceChildren();for(const `... 5200 more characters,
