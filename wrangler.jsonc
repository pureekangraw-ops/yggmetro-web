{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yggmetro-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "services": [
    {
      "binding": "GO_HUB",
      "service": "go-hub"
    },
    {
      "binding": "PANTHEON",
      "service": "phatheon-workhub",
      "entrypoint": "StorefrontBridge"
    }
  ],
  "vars": {
    "BRIEF_REGISTRY_BACKEND": "go-hub"
  }
}
