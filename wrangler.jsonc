{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yggmetro-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "services": [
    {
      "binding": "GO_HUB",
      "service": "go-hub"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "previews": {}
}
